<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemaganadero.controller.PotrerosController"
      spacing="0" styleClass="page-container">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header-bar">
        <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        <children>
            <VBox spacing="2">
                <children>
                    <Label text="Gestión Inteligente de Potreros y Alimentación" styleClass="page-title"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <children>
                            <Label text="Finca:" styleClass="page-subtitle"/>
                            <Label fx:id="lblFinca" styleClass="page-subtitle-accent"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalPotreros" styleClass="total-badge"/>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar-bar">
        <padding><Insets top="12" right="22" bottom="12" left="22"/></padding>
        <children>
            <TextField fx:id="txtBuscar" promptText="Buscar potrero por nombre o código..." prefWidth="320" styleClass="search-field"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo Potrero" onAction="#registrarPotrero" styleClass="btn-primary-action"/>
            <Button text="Recomendaciones" onAction="#mostrarRecomendaciones" styleClass="btn-primary-action"/>
        </children>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="22" bottom="22" left="22"/></padding>
        <children>
            <TableView fx:id="tablaPotreros" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
                    <TableColumn fx:id="colArea" text="Área (ha)" prefWidth="80"/>
                    <TableColumn fx:id="colPasto" text="Pasto" prefWidth="140"/>
                    <TableColumn fx:id="colAltura" text="Altura cm" prefWidth="80"/>
                    <TableColumn fx:id="colPh" text="pH" prefWidth="60"/>
                    <TableColumn fx:id="colClima" text="Clima" prefWidth="90"/>
                    <TableColumn fx:id="colDesgaste" text="Desgaste" prefWidth="80"/>
                    <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="80"/>
                    <TableColumn fx:id="colLote" text="Lote" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                    <TableColumn fx:id="colAccion" text="Acción" prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="No hay potreros registrados. Use '+ Nuevo Potrero' para comenzar."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                </placeholder>
            </TableView>
        </children>
    </VBox>
</VBox>
