<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemaganadero.controller.SanidadController"
      spacing="0" styleClass="page-container">

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header-bar">
        <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
        <children>
            <VBox spacing="2">
                <children>
                    <Label text="Sanidad y Vacunación" styleClass="page-title"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <children>
                            <Label text="Finca:" styleClass="page-subtitle"/>
                            <Label fx:id="lblFinca" styleClass="page-subtitle-accent"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotalVacunas" styleClass="total-badge"/>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar-bar">
        <padding><Insets top="12" right="22" bottom="12" left="22"/></padding>
        <children>
            <TextField fx:id="txtBuscar" promptText="Buscar por nombre, arete, vacuna o responsable..." prefWidth="320" styleClass="search-field"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Registrar Vacuna" onAction="#registrarVacuna" styleClass="btn-primary-action"/>
            <Button text="+ Tratamiento" onAction="#registrarTratamiento" styleClass="btn-primary-action"/>
            <Button text="Pendientes" onAction="#mostrarPendientes" styleClass="btn-primary-action"/>
        </children>
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <padding><Insets top="0" right="22" bottom="22" left="22"/></padding>
        <children>
            <TableView fx:id="tablaVacunas" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colArete" text="Arete" prefWidth="85"/>
                    <TableColumn fx:id="colNombreAnimal" text="Animal" prefWidth="110"/>
                    <TableColumn fx:id="colLote" text="Lote" prefWidth="105"/>
                    <TableColumn fx:id="colFinca" text="Finca" prefWidth="115"/>
                    <TableColumn fx:id="colVacuna" text="Vacuna" prefWidth="135"/>
                    <TableColumn fx:id="colFechaApp" text="Aplicación" prefWidth="95"/>
                    <TableColumn fx:id="colProxDosis" text="Próx. Dosis" prefWidth="95"/>
                    <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="105"/>
                    <TableColumn fx:id="colAccion" text="Acción" prefWidth="80"/>
                </columns>
                <placeholder>
                    <Label text="No hay vacunas registradas. Use '+ Registrar Vacuna' para comenzar."
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>
                </placeholder>
            </TableView>
        </children>
    </VBox>
</VBox>
